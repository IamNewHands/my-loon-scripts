#!name = GitHubPro
#!desc = GitHub 客户端增强：解锁订阅 + README/issue/Release 的标题与正文翻译（双语或纯译文）。译文跟随原文大小。解锁部分原作者 baby；翻译走 Google 免费端点，无需密钥。
#!date = 2026-10-17 22:40
#!category = GitHubPro
#!author = IamNewHands[https://github.com/IamNewHands] ｜ 解锁部分原作者 baby[https://github.com/Yu9191]
#!homepage = https://github.com/IamNewHands/my-loon-scripts/tree/main/loon/GitHubPro
#!icon = https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/Icons/AppIcons/Image/App/GitHub.png
#!openUrl = https://apps.apple.com/app/id1477376905

[Argument]
Enable = switch,true,tag=[翻译] 总开关,desc=关闭后只保留原有解锁功能
Mode = select,"bilingual","pure",tag=[翻译] 显示模式,desc=bilingual=原文与译文并列；pure=只显示译文
TargetLang = select,"zh-CN","zh-TW","en","ja",tag=[翻译] 目标语言,desc=译文使用的语言
TranslateReadme = switch,true,tag=[范围] 仓库首页,desc=翻译 README 正文与仓库简介
TranslateIssue = switch,true,tag=[范围] issue/PR,desc=翻译详情正文、评论与标题
TranslateRelease = switch,false,tag=[范围] Release,desc=翻译 Release 说明
Debug = switch,false,tag=[调试] 脚本日志,desc=在 Loon「脚本任务」里输出 [GitHubPro] 执行信息
ClearCache = switch,false,tag=[缓存] 清空缓存,desc=打开后每次运行先清空翻译缓存（等于临时停用缓存），用完请手动关掉
TitleFormat = select,"line","html",tag=[标题] 双语格式,desc=line=硬换行+「译：」前缀（默认，任何情况都能分出译文）；html=译文另起一行且字号更小（若标题里出现尖括号标签就切回 line）

[Script]
# > GitHub 解锁（原作者 baby）
# > README / issue / Release 翻译
http-response ^https:\/\/api\.github\.com\/graphql script-path=https://raw.githubusercontent.com/IamNewHands/my-loon-scripts/main/loon/GitHubPro/GithubPro.js, requires-body=true, timeout=60, argument=[{Enable},{Mode},{TargetLang},{TranslateReadme},{TranslateIssue},{TranslateRelease},{Debug},{ClearCache},{TitleFormat}], tag=GithubPro

[MITM]
hostname = api.github.com
