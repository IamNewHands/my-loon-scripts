[Script]
# > Documents解锁订阅
http-request https://license.pdfexpert.com/api/2.0/documents/subscription/refresh script-path=https://raw.githubusercontent.com/IamNewHands/my-loon-scripts/main/loon/Documents/JS/Documents.js, requires-body=true, timeout=60, tag=Documents解锁订阅

[MITM]
hostname = *.pdfexpert.com
